{
  "name": "xmpp-react-hooks",
  "version": "0.1.0",
  "description": "react hooks for xmpp",
  "keywords": [
    "hooks",
    "react",
    "xmpp",
    "xmpp-react-hooks"
  ],
  "homepage": "https://gitlab.com/bitspur/misc/xmpp-react-hooks",
  "bugs": {
    "url": "https://gitlab.com/bitspur/misc/xmpp-react-hooks/-/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jam Risser",
    "email": "jam@codejam.ninja",
    "url": "https://codejam.ninja"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/bitspur/misc/xmpp-react-hooks.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf lib coverage .tsbuildinfo",
    "format": "oxfmt .",
    "lint": "oxlint --deny-warnings && oxfmt --check .",
    "test": "pnpm run test/unit && pnpm run test/integration",
    "test/integration": "vitest run --project integration --coverage --coverage.reportsDirectory=coverage/integration",
    "test/unit": "vitest run --project unit --coverage --coverage.reportsDirectory=coverage/unit",
    "test/watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/ltx": "^3.1.1",
    "@types/xmpp__client": "^0.14.1",
    "@types/xmpp__debug": "^0.14.0",
    "@types/xmpp__error": "^0.14.0",
    "@types/xmpp__events": "^0.14.0",
    "@types/xmpp__iq": "^0.14.0",
    "@types/xmpp__jid": "^0.14.0",
    "@types/xmpp__xml": "^0.14.0",
    "@xmpp-ts/jid": "^0.0.61",
    "@xmpp-ts/message": "^0.0.61",
    "@xmpp-ts/presence": "^0.0.61",
    "@xmpp-ts/roster": "^0.0.61",
    "@xmpp-ts/vcard": "^0.0.61",
    "@xmpp/client": "^0.14.0",
    "@xmpp/debug": "^0.14.0",
    "@xmpp/error": "^0.14.0",
    "@xmpp/events": "^0.14.0",
    "@xmpp/iq": "^0.14.0",
    "@xmpp/jid": "^0.14.0",
    "@xmpp/xml": "^0.14.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "peerDependencyRules": {
      "//": "@xmpp-ts 0.0.61 still declares peers on the 0.11 line. It only touches @xmpp/xml, @xmpp/events and @xmpp/jid at runtime, and those APIs are unchanged in 0.14 (verified by the integration suite), so a single 0.14 copy is deliberate.",
      "allowedVersions": {
        "@xmpp/client": "0.14",
        "@xmpp/error": "0.14",
        "@xmpp/events": "0.14",
        "@xmpp/iq": "0.14",
        "@xmpp/jid": "0.14"
      }
    },
    "overrides": {
      "@types/ltx": "^3.1.1"
    }
  }
}
